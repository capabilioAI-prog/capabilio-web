{"nodes": [{"id": "arena_v2_blueprint_frozen_spec", "label": "Arena V2 Blueprint (FROZEN v1.1)", "file_type": "document", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_career_family", "label": "Career Family (root taxonomy)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserving the Career Family taxonomy now costs nothing and saves a future refactor: adding a second family later means adding a new arena-content/ package tree, not touching the 11 Arena Engine backend modules, since none of them are IT-specific in their logic, only in their content."}, {"id": "arena_v2_blueprint_arena_engine", "label": "Arena Engine (11 backend modules)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_arena_content", "label": "Arena Content (package tree)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splitting Arena Engine (zero domain-specific terms) from Arena Content makes 'the same Arena Engine powers every Career Family' an enforceable constraint: if the Engine ever needs a code change to consume a new content package, that signals the boundary was violated."}, {"id": "arena_v2_blueprint_capability_registry", "label": "Capability Registry module (\u00a71.1)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Belongs in Content, not Engine, because the registry (which workstations a role may use) is role-specific authored data like Skill Graphs and Scenario Packs; the Engine only checks the payload against the registry entry, never hardcodes per-role logic, which is what makes adding new roles/Career Families additive rather than requiring engine code changes."}, {"id": "arena_v2_blueprint_challenge_payload_validator", "label": "Challenge Payload Validator module", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_challenge_library", "label": "Challenge Library module", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_challenge_engine", "label": "Challenge Engine module", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_workstation_router", "label": "Workstation Router module", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_submission_engine", "label": "Submission Engine module", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_assessment_layer", "label": "Assessment Layer (\u00a76)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI qualitative review is supplement only \u2014 it can explain why and nudge a sub-score within the validator-set range but can never override a failing validator result into a passing score; this is now enforced structurally by the pipeline shape rather than by code review catching it after the fact."}, {"id": "arena_v2_blueprint_portfolio_decision", "label": "Portfolio Decision (\u00a75)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_elo_xp_engine", "label": "ELO / XP Engine module", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_industry_layer", "label": "Industry Layer (\u00a72)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_skill_dependencies_dag", "label": "Skill Dependencies DAG (\u00a75)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_versioning", "label": "Versioning (\u00a77)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A student mid-progress on a content version stays pinned to that exact version even if a newer one ships mid-session; new starts always resolve to latest. This lets content improve continuously without invalidating in-flight work or retroactively changing what a completed Portfolio artifact was validated against."}, {"id": "arena_v2_blueprint_dataset_versioning", "label": "Dataset Versioning (\u00a77.1)", "file_type": "concept", "source_file": "arena_v2_blueprint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arena_v2_blueprint_analytics", "label"