{"nodes": [{"id": "claude_skills_graphify_references_extraction_spec_subagent_prompt", "label": "Extraction Subagent Prompt", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact prompt every semantic chunk subagent receives verbatim; loaded only in Step 3 Part B when the corpus has at least one doc/paper/image chunk."}, {"id": "claude_skills_graphify_references_extraction_spec_confidence_rubric", "label": "EXTRACTED/INFERRED/AMBIGUOUS Confidence Rubric", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discrete rubric (0.95/0.85/0.75/0.65/0.55) chosen because a continuous 0-1 range collapses to a bimodal distribution in production (>50% at 0.5, >40% at 0.85+); models follow discrete rubrics better than ranges."}, {"id": "claude_skills_graphify_references_extraction_spec_node_id_format", "label": "Node ID Format Rule", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full repo-relative path (every segment) + normalized entity name, must match the AST extractor's ID scheme exactly, or re-extraction creates orphan ghost-duplicate nodes."}, {"id": "claude_skills_graphify_references_extraction_spec_hyperedge_rule", "label": "Hyperedge Extraction Rule", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only add a hyperedge when 3+ nodes share a concept/flow/pattern not captured by pairwise edges alone; max 3 per chunk."}],